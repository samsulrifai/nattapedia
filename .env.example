# Salin ke .env.local lalu isi. JANGAN commit .env.local.
# Nilai production/preview disimpan di Vercel Environment Variables (dikelola DevOps).

# URL situs (tanpa garis miring di akhir)
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya server. Rahasia, jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anti-spam formulir kontak (Cloudflare Turnstile, tier gratis). Opsional.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
