# Salin ke .env.local lalu isi. JANGAN commit .env.local.
# Nilai preview/production disimpan di Vercel Environment Variables (dikelola DevOps).

# URL situs (tanpa garis miring di akhir)
NEXT_PUBLIC_SITE_URL=

# Database: Neon Postgres (paket Free). Neon Console > Connect.
# DATABASE_URL = connection string pooled (host berisi "-pooler"), dipakai aplikasi.
# DATABASE_URL_UNPOOLED = koneksi langsung, dipakai migrasi dan script admin.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth admin (Better Auth). Rahasia, minimal 32 karakter acak:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL dasar auth. Kosongkan di preview Vercel (otomatis memakai VERCEL_URL).
BETTER_AUTH_URL=

# Storage gambar: Cloudflare R2 (tier gratis). Cloudflare > R2 > Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL publik bucket (r2.dev atau domain kustom), tanpa garis miring di akhir.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=

# Anti-spam formulir kontak (Cloudflare Turnstile, tier gratis). Opsional.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
